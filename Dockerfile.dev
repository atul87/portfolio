FROM node:24-bookworm-slim AS base
WORKDIR /app
RUN npm i -g pnpm@10
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

FROM node:24-bookworm-slim AS release
WORKDIR /app
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

RUN npm i -g pnpm@10

COPY --from=base /app ./

RUN chown -R node:node /app

USER node

EXPOSE 3000

CMD ["pnpm", "dev"]
